GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=gemini-embedding-001
RAG_MIN_SIMILARITY=0.35
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatbot-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-postgres-password
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true

# Optional read-only order provider; leave empty to use the built-in order service.
# Expected contract: GET /orders/{reference}, bearer auth and X-Workspace-ID.
ORDER_API_BASE_URL=
ORDER_API_TOKEN=

# Docker Compose supplies Redis, private upload storage and non-owner DB roles.
# Set these for a standalone API/worker setup; Compose overrides them internally.
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=/tmp/resolveai-uploads
RESOLVEAI_INLINE_WORKER=false
# Set different strong passwords for these runtime roles in a production deployment.
# Empty values use POSTGRES_PASSWORD for local Docker convenience.
RESOLVEAI_APP_PASSWORD=
RESOLVEAI_WORKER_PASSWORD=
